{
  "config": {
    "default": true,
    "code-block-style": { "style": "fenced" },
    "descriptive-link-text": false,
    "heading-increment": { "front_matter_title": "" },
    "header-style": { "style": "atx" },
    "hr-style": { "style": "---" },
    "line-length": {
      "code_blocks": false,
      "tables": false,
      "headings": true,
      "heading_line_length": 120,
      "line_length": 5000
    },
    "no-bare-urls": false,
    "no-duplicate-heading": { "siblings_only": true },
    "no-emphasis-as-heading": false,
    "no-inline-html": false,
    "table-column-style": false,
    "no-trailing-punctuation": { "punctuation": ".,;:!。，；：！？" },
    "no-trailing-spaces": false
  },
  "ignores": [".github/**", ".publico/**", ".claude/skills/**", "10-19-estrategia-e-governanca/15-melhoria-e-conhecimento/15.02-manual-da-gitlab-traduzido/traducao/**"]
}
